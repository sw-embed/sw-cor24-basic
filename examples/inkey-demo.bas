10 PRINT "PRESS ANY KEY TO START..."
20 LET R = 0
30 LET R = R + 1
40 LET K = INKEY
50 IF K < 0 THEN GOTO 30
60 PRINT "KEY ";K
70 LET R = (R * 97 + 1) MOD 8191
80 PRINT "SEED ";R
90 PRINT "PRESS ESC TO CANCEL."
100 FOR I = 1 TO 100
110 LET K = INKEY
120 IF K = 27 THEN GOTO 170
130 NEXT I
140 PRINT "DONE."
150 END
170 PRINT "CANCELLED."
